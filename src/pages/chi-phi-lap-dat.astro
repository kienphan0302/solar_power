---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Consultation from '../components/Consultation.astro';
import {products,money,productHref} from '../data/catalog';
---
<BaseLayout title="Chi phí lắp điện mặt trời & cấu hình tham khảo | Hướng Dương Solar"><PageIntro eyebrow="CHI PHÍ & BÁO GIÁ" title="Báo giá cần rõ từ cấu hình." description="Tham khảo mức giá trong danh mục. Giá chính thức được xác nhận theo thiết bị, nhu cầu sử dụng và điều kiện thi công."/><section class="section container"><div class="section-heading"><div><p class="eyebrow">DANH MỤC THAM KHẢO NGÀY 22/11/2026</p><h2>So sánh các cấu hình.</h2></div></div><div class="table-scroll"><table class="pricing-table"><thead><tr><th>Cấu hình</th><th>Nhóm giải pháp</th><th>Giá tham khảo</th><th>Chi tiết</th></tr></thead><tbody>{products.map(p=><tr><td>{p.capacity} kW</td><td>{p.categoryLabel}</td><td><strong>{money(p.price)}</strong></td><td><a class="inline-link" href={productHref(p.slug)}>Xem cấu hình</a></td></tr>)}</tbody></table></div><p class="price-note">Các mức giá được đối chiếu từ danh mục website Hướng Dương Solar. Hạng mục bao gồm, thuế, thiết bị và chi phí phát sinh cần được ghi rõ trong báo giá gửi khách.</p><div class="info-columns"><article><h3>Thiết bị</h3><p>Model, số lượng tấm pin, biến tần và dung lượng lưu trữ nếu có.</p></article><article><h3>Điều kiện công trình</h3><p>Kết cấu mái, bóng che, vị trí đặt thiết bị và chiều dài đường dây.</p></article><article><h3>Phạm vi cung cấp</h3><p>Vật tư, vận chuyển, thi công, bàn giao và điều kiện bảo hành.</p></article></div></section><Consultation title="Nhận báo giá theo công trình của bạn."/></BaseLayout>
