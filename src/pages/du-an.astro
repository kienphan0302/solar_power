---
import {Image} from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Consultation from '../components/Consultation.astro';
import roof from '../assets/solar/roof-detail.jpg';
import installation from '../assets/solar/installation.jpg';
import panels from '../assets/solar/solar-panels.webp';
---
<BaseLayout title="Hình ảnh & quy trình triển khai điện mặt trời | Hướng Dương Solar"><PageIntro eyebrow="HÌNH ẢNH & TRIỂN KHAI" title="Từ mái nhà đến phương án thực tế." description="Hình ảnh minh họa từ tư liệu website và những nội dung cần thống nhất trong quá trình triển khai."/><section class="section container"><div class="gallery-grid"><figure><Image src={roof} alt="Minh họa bố trí tấm pin trên mái tôn" width={1000} format="webp"/><figcaption>Bố trí tấm pin trên mái nhà.</figcaption></figure><figure><Image src={installation} alt="Ảnh minh họa công việc lắp đặt tấm pin" width={800} format="webp"/><figcaption>Minh họa công việc lắp đặt.</figcaption></figure><figure><Image src={panels} alt="Ảnh minh họa các tấm pin điện mặt trời" width={800} format="webp"/><figcaption>Các tấm pin điện mặt trời.</figcaption></figure></div><p class="price-note">Ảnh minh họa lấy từ kho tư liệu website Hướng Dương Solar. Liên hệ để trao đổi hồ sơ công trình phù hợp với nhu cầu của bạn.</p><div class="section-heading spaced-heading"><div><p class="eyebrow">NỘI DUNG CẦN THỐNG NHẤT</p><h2>Trước, trong và sau thi công.</h2></div></div><div class="info-columns"><article><h3>Trước thi công</h3><p>Khảo sát, thống nhất cấu hình thiết bị, phạm vi cung cấp và báo giá.</p></article><article><h3>Trong thi công</h3><p>Phương án lắp đặt, bố trí thiết bị, đường dây và tiến độ thực hiện.</p></article><article><h3>Khi bàn giao</h3><p>Kiểm tra vận hành, hướng dẫn sử dụng, hồ sơ và đầu mối bảo hành.</p></article></div></section><Consultation/></BaseLayout>
