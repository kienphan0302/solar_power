---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import Consultation from '../components/Consultation.astro';
import Testimonials from '../components/Testimonials.astro';
import { products } from '../data/catalog';
import roof from '../assets/solar/roof-detail.jpg';
import panels from '../assets/solar/solar-panels.webp';
import { site } from '../config/site';
const featured = [products.find(p=>p.id===458)!, products.find(p=>p.id===468)!, products.find(p=>p.id===478)!, products.find(p=>p.id===485)!];
---
<BaseLayout title="Hướng Dương Solar | Giải pháp điện mặt trời cho gia đình & doanh nghiệp">
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="tiny-sun">☀</span> ĐIỆN MẶT TRỜI HƯỚNG DƯƠNG</p><h1>Năng lượng từ nắng.<br /><em>Giá trị cho mái nhà.</em></h1><p class="hero-description">Giải pháp điện mặt trời hòa lưới và hybrid lưu trữ, được tư vấn theo nhu cầu sử dụng điện của gia đình và doanh nghiệp.</p><div class="hero-actions"><a class="button" href="#tu-van">Nhận tư vấn cấu hình</a><a class="button button-outline" href="/san-pham/">Khám phá sản phẩm</a></div><div class="hero-notes"><span><Icon name="check" size={17} />Khảo sát nhu cầu</span><span><Icon name="check" size={17} />Báo giá rõ hạng mục</span></div></div><div class="hero-media"><Image src={roof} alt="Hệ thống tấm pin điện mặt trời lắp trên mái nhà, ảnh từ website Hướng Dương Solar" width={900} format="webp" loading="eager" fetchpriority="high" /><div class="hero-image-label"><span class="label-sun"><Icon name="sun" size={26} /></span><div><strong>Điện mặt trời mái nhà</strong><span>Bắt đầu từ một phương án phù hợp.</span></div></div></div></div></section>
<section class="benefits-strip"><div class="container benefits-grid">{[['panel','Giải pháp theo nhu cầu','Gia đình · Cửa hàng · Doanh nghiệp'],['tools','Tư vấn & triển khai','Trao đổi từ khảo sát đến bàn giao'],['shield','Thông tin thiết bị rõ ràng','Xác nhận cấu hình và bảo hành'],['chat','Đồng hành khi sử dụng','Liên hệ hỗ trợ qua hotline, Zalo']].map(([icon,title,desc])=><div><Icon name={icon} size={29}/><span><strong>{title}</strong><small>{desc}</small></span></div>)}</div></section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow">GIẢI PHÁP ĐIỆN MẶT TRỜI</p><h2>Chọn theo cách bạn dùng điện.</h2></div><p>Mỗi nhu cầu sử dụng cần một cấu hình được tính toán riêng.</p></div><div class="solution-grid"><a class="solution-card" href="/giai-phap/hoa-luoi/"><span class="solution-icon"><Icon name="panel" size={33}/></span><div><p class="eyebrow">KHAI THÁC ĐIỆN BAN NGÀY</p><h3>Hòa lưới bám tải</h3><p>Tìm phương án phù hợp với phụ tải tiêu thụ và điều kiện đấu nối của công trình.</p><span class="inline-link">Tìm hiểu giải pháp</span></div></a><a class="solution-card dark" href="/giai-phap/luu-tru/"><span class="solution-icon"><Icon name="battery" size={33}/></span><div><p class="eyebrow">ĐÁNH GIÁ THÊM NHU CẦU LƯU TRỮ</p><h3>Hybrid lưu trữ</h3><p>Cân nhắc điện buổi tối và tải dự phòng với phương án lưu trữ phù hợp.</p><span class="inline-link">Tìm hiểu giải pháp</span></div></a></div></section>
<section class="section product-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">DANH MỤC ĐANG GIỚI THIỆU</p><h2>Cấu hình để bạn tham khảo.</h2></div><a class="inline-link" href="/san-pham/">Xem tất cả sản phẩm</a></div><div class="product-grid">{featured.map(product=><ProductCard product={product}/>)}</div><p class="price-note">Giá tham khảo theo danh mục ngày 22/11/2026. Thiết bị, dung lượng lưu trữ và chi phí thi công được xác nhận trong báo giá sau khảo sát.</p></div></section>
<section class="section container about-grid"><div class="about-photo"><Image src={panels} alt="Các tấm pin điện mặt trời, hình minh họa" width={750} format="webp" loading="lazy"/><div class="photo-caption">Hướng đến sử dụng năng lượng hiệu quả hơn.</div></div><div class="about-copy"><p class="eyebrow">VỀ HƯỚNG DƯƠNG SOLAR</p><h2>Hiểu rõ công trình.<br />Đề xuất đúng nhu cầu.</h2><p>{site.company} giới thiệu các giải pháp điện mặt trời cho hộ gia đình và doanh nghiệp, từ hòa lưới bám tải đến hệ thống có lưu trữ.</p><ul class="check-list"><li><Icon name="check"/>Trao đổi về thói quen và thời điểm dùng điện</li><li><Icon name="check"/>Khảo sát mái và điều kiện lắp đặt</li><li><Icon name="check"/>Thống nhất thiết bị, phạm vi công việc và báo giá</li></ul><a class="button button-outline" href="/gioi-thieu/">Tìm hiểu về chúng tôi</a></div></section>
<section class="process-section section"><div class="container"><div class="section-heading"><div><p class="eyebrow">TỪ KHẢO SÁT ĐẾN VẬN HÀNH</p><h2>Mỗi bước đều cần rõ ràng.</h2></div><a class="inline-link" href="/du-an/">Xem quy trình triển khai</a></div><div class="process-grid">{[['Tiếp nhận nhu cầu','Hóa đơn điện, thời điểm sử dụng, nhu cầu dự phòng.'],['Khảo sát thực tế','Diện tích mái, bóng che, vị trí lắp thiết bị và đi dây.'],['Đề xuất & báo giá','Cấu hình, phạm vi thi công, tiến độ và điều kiện bảo hành.'],['Thi công & bàn giao','Kiểm tra vận hành và hướng dẫn theo dõi hệ thống.']].map(([title,text],i)=><article><span class="process-step">0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow">TRƯỚC KHI QUYẾT ĐỊNH</p><h2>Hiểu đúng để chọn phù hợp.</h2></div><a class="inline-link" href="/kien-thuc/">Góc kiến thức</a></div><div class="editorial-grid"><a class="editorial-main" href="/chi-phi-lap-dat/"><p class="eyebrow">CHI PHÍ & BÁO GIÁ</p><h3>Một báo giá điện mặt trời cần có những gì?</h3><p>So sánh thiết bị, dung lượng lưu trữ và phạm vi thi công để hiểu rõ tổng chi phí.</p><span class="inline-link">Xem hướng dẫn đọc báo giá</span></a><div class="editorial-links"><a href="/kien-thuc/chon-hoa-luoi-hay-luu-tru/"><span>CHỌN GIẢI PHÁP</span><h3>Hòa lưới hay hybrid lưu trữ?</h3><p>Những câu hỏi cần trả lời từ nhu cầu sử dụng điện.</p></a><a href="/kien-thuc/chuan-bi-truoc-khao-sat/"><span>CHUẨN BỊ KHẢO SÁT</span><h3>Chuẩn bị trước buổi tư vấn.</h3><p>Hóa đơn điện, ảnh mái và danh sách thiết bị cần dùng.</p></a></div></div></section>
<Testimonials />
<Consultation />
</BaseLayout>
