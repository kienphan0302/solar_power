---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../config/site';
const steps = [
  ['Tiếp nhận nhu cầu', 'Trao đổi về hóa đơn điện, thời điểm sử dụng và nhu cầu dự phòng.'],
  ['Khảo sát mái nhà', 'Kiểm tra diện tích, hướng mái và điều kiện thi công thực tế.'],
  ['Đề xuất & báo giá', 'Thống nhất cấu hình, phạm vi công việc và điều kiện bảo hành.'],
  ['Thi công & bàn giao', 'Lắp đặt, kiểm tra vận hành và hướng dẫn theo dõi hệ thống.']
];
const faqs = [
  ['Mái nhà của tôi có lắp được không?', 'Cần khảo sát diện tích, hướng mái, khả năng chịu tải, bóng che và vị trí đi dây để đề xuất phương án phù hợp.'],
  ['Chi phí lắp đặt được xác định thế nào?', 'Chi phí phụ thuộc công suất, thiết bị, nhu cầu lưu trữ và điều kiện thi công. Báo giá cần ghi rõ các hạng mục được bao gồm.'],
  ['Mất điện thì hệ thống có hoạt động không?', 'Điều này phụ thuộc cấu hình và thiết bị. Khả năng cấp điện dự phòng cần được xác nhận trong phương án kỹ thuật cụ thể.'],
  ['Tôi cần chuẩn bị gì để được tư vấn?', 'Bạn có thể chuẩn bị hóa đơn điện gần nhất, ảnh mái nhà và thông tin về thời điểm sử dụng điện trong ngày.']
];
---
<BaseLayout title={`Tư vấn điện mặt trời gia đình | ${site.brand}`}>
  <section class="hero section-shell">
    <div class="hero-copy">
      <p class="eyebrow">GIẢI PHÁP ĐIỆN MẶT TRỜI CHO GIA ĐÌNH</p>
      <h1>Hiểu nhu cầu điện.<br /><span>Chọn đúng giải pháp.</span></h1>
      <p class="hero-description">Đề xuất cấu hình điện mặt trời theo thói quen sử dụng điện và điều kiện mái nhà của bạn.</p>
      <div class="actions"><a class="button" href="#tu-van">Nhận tư vấn phù hợp</a><a class="text-link" href="#giai-phap">Tìm hiểu giải pháp</a></div>
      <p class="hero-note">Trao đổi nhu cầu · Khảo sát thực tế · Báo giá theo cấu hình</p>
    </div>
    <div class="solar-visual" role="img" aria-label="Minh họa mái nhà với các tấm pin điện mặt trời">
      <div class="visual-sun"></div><div class="visual-label">Năng lượng từ mái nhà</div>
      <div class="roof"><div class="panels">{Array.from({length: 6}, () => <div class="panel"></div>)}</div></div>
      <div class="house"><div class="window"></div><div class="window"></div><div class="door"></div></div>
      <div class="visual-caption">Cấu hình phù hợp bắt đầu từ nhu cầu thực tế.</div>
    </div>
  </section>
  <section id="giai-phap" class="section-shell">
    <div class="section-heading"><p class="eyebrow">LỰA CHỌN THEO NHU CẦU</p><h2>Bạn muốn giải quyết điều gì?</h2><p>Phương án kỹ thuật được xác định sau khi trao đổi và khảo sát.</p></div>
    <div class="solution-grid">
      <article class="solution-card"><span class="card-icon" aria-hidden="true">☀</span><h3>Tận dụng điện ban ngày</h3><p>Tìm hiểu hệ thống phù hợp với lượng điện sử dụng trong thời gian có nắng.</p></article>
      <article class="solution-card"><span class="card-icon" aria-hidden="true">▤</span><h3>Cân nhắc thêm lưu trữ</h3><p>Đánh giá nhu cầu dùng điện vào buổi tối và khả năng cấp điện dự phòng.</p></article>
      <article class="solution-card"><span class="card-icon" aria-hidden="true">⌂</span><h3>Kiểm tra điều kiện mái</h3><p>Xác định diện tích, bóng che và các hạng mục cần chuẩn bị trước khi lắp đặt.</p></article>
    </div>
  </section>
  <section id="quy-trinh" class="process-section"><div class="section-shell"><div class="section-heading"><p class="eyebrow">TỪ TƯ VẤN ĐẾN BÀN GIAO</p><h2>Mỗi bước đều rõ ràng.</h2></div><div class="process-grid">{steps.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
  <section class="section-shell faq-section"><div class="section-heading"><p class="eyebrow">THÔNG TIN TRƯỚC KHI QUYẾT ĐỊNH</p><h2>Những điều bạn có thể đang băn khoăn.</h2></div><div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
  <section id="tu-van" class="consult-section section-shell"><div><p class="eyebrow">BẮT ĐẦU TỪ NHU CẦU CỦA BẠN</p><h2>Cùng tìm phương án<br />phù hợp cho mái nhà.</h2><p>Để lại thông tin để trao đổi về cấu hình và các bước khảo sát.</p>{site.phone && <p><a class="text-link" href={`tel:${site.phone}`} data-track="click_phone">Gọi {site.phone}</a></p>}{site.zalo && <p><a class="text-link" href={site.zalo} target="_blank" rel="noopener noreferrer" data-track="click_zalo">Trao đổi qua Zalo</a></p>}</div><LeadForm /></section>
</BaseLayout>
