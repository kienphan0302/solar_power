---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Consultation from '../../components/Consultation.astro';
import Icon from '../../components/Icon.astro';
import { products, money, type Product } from '../../data/catalog';
import { site } from '../../config/site';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.slug},props:{product}}));}
interface Props {product:Product;}
const {product}=Astro.props;
const storage=product.category==='luu-tru';
---
<BaseLayout title={`${product.name} | Hướng Dương Solar`} description={`Tham khảo ${product.name.toLowerCase()}, giá ${money(product.price)}. Liên hệ để xác nhận thiết bị và phương án thi công sau khảo sát.`}><section class="section container product-detail"><nav class="breadcrumbs"><a href="/">Trang chủ</a><span>/</span><a href="/san-pham/">Sản phẩm</a><span>/</span><span>{product.capacity} kW</span></nav><div class="product-detail-grid"><div class="detail-image"><Image src={product.image} alt={product.name} width={800} format="webp" loading="eager" /></div><div class="detail-summary"><p class="eyebrow">{product.categoryLabel}</p><h1>{product.name}</h1><p class="detail-lead">{storage?'Tham khảo phương án điện mặt trời có lưu trữ theo nhu cầu dùng điện và tải dự phòng của công trình.':'Tham khảo phương án hòa lưới bám tải theo phụ tải tiêu thụ và điều kiện đấu nối của công trình.'}</p><div class="detail-price"><span>Giá tham khảo</span><strong>{money(product.price)}</strong><small>Cấu hình và chi phí cuối cùng được xác nhận sau khảo sát.</small></div><ul class="check-list"><li><Icon name="check"/>Tư vấn phương án thiết bị phù hợp</li><li><Icon name="check"/>Trao đổi rõ phạm vi thi công</li><li><Icon name="check"/>Xác nhận điều kiện bảo hành theo thiết bị</li></ul><div class="hero-actions"><a class="button" href="#tu-van">Tư vấn cấu hình này</a><a class="button button-outline" href={`tel:${site.phone}`} data-track="click_phone">Gọi {site.phoneDisplay}</a></div></div></div><div class="detail-content"><article><h2>Thông tin cần xác nhận trong báo giá</h2><div class="spec-table"><div><span>Nhóm giải pháp</span><strong>{product.categoryLabel}</strong></div><div><span>Công suất cấu hình giới thiệu</span><strong>{product.capacity} kW</strong></div><div><span>Tấm pin và biến tần</span><strong>Model, số lượng và công suất ghi trong báo giá</strong></div><div><span>Pin lưu trữ</span><strong>{storage?'Dung lượng kWh, model và phạm vi dự phòng cần được xác nhận':'Theo phương án tư vấn cụ thể'}</strong></div><div><span>Thi công & vật tư</span><strong>Thống nhất sau khảo sát mái và vị trí lắp đặt</strong></div><div><span>Bảo hành</span><strong>Theo thiết bị và hạng mục trong hợp đồng</strong></div></div><p class="price-note">Giá tham khảo đối chiếu danh mục ngày 22/11/2026. Công suất kW của cấu hình không đồng nghĩa với dung lượng lưu trữ kWh hoặc sản lượng thực tế.</p></article><aside class="detail-help"><Icon name="chat" size={32}/><h3>Chưa chắc cấu hình này phù hợp?</h3><p>Chuẩn bị hóa đơn điện, ảnh mái nhà và các thiết bị cần sử dụng để được trao đổi phương án cụ thể.</p><a class="inline-link" href="#tu-van">Trao đổi với tư vấn viên</a></aside></div></section><section class="section product-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">THAM KHẢO THÊM</p><h2>Cấu hình cùng nhóm.</h2></div></div><div class="product-grid">{products.filter(p=>p.category===product.category&&p.id!==product.id).slice(0,4).map(p=><ProductCard product={p}/>)}</div></div></section><Consultation title={`Trao đổi về cấu hình ${product.capacity} kW.`}/></BaseLayout>
