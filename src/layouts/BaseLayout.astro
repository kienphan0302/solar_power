---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
interface Props { title: string; description?: string; }
const { title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = Astro.url.pathname;
const configuredGtm = import.meta.env.PUBLIC_GTM_ID || '';
const gtmId = /^GTM-[A-Z0-9]+$/.test(configuredGtm) ? configuredGtm : '';
const nav = [['/', 'Trang chủ'], ['/giai-phap/hoa-luoi/', 'Giải pháp'], ['/san-pham/', 'Sản phẩm'], ['/chi-phi-lap-dat/', 'Chi phí lắp đặt'], ['/du-an/', 'Hình ảnh'], ['/kien-thuc/', 'Kiến thức'], ['/lien-he/', 'Liên hệ']];
---
<!doctype html><html lang="vi"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#073f36" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:locale" content="vi_VN" /><meta property="og:url" content={canonical.href} /><link rel="canonical" href={canonical.href} /><link rel="icon" href="/favicon.svg" type="image/svg+xml" />{!site.readyToIndex && <meta name="robots" content="noindex,nofollow" />}<title>{title}</title>
{gtmId && <script is:inline define:vars={{ gtmId }}>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);</script>}
</head><body><a class="skip-link" href="#main">Đến nội dung chính</a>
<div class="topbar"><div class="container topbar-inner"><span>Năng lượng xanh. Tương lai bền vững.</span><a href={`mailto:${site.email}`}><Icon name="mail" size={15} />{site.email}</a></div></div>
<header class="site-header"><div class="container header-main"><a href="/" class="brand" aria-label="Hướng Dương Solar – Trang chủ"><span class="brand-symbol"><Icon name="sun" size={36} /></span><span>HƯỚNG DƯƠNG<small>SOLAR · ĐIỆN NĂNG LƯỢNG MẶT TRỜI</small></span></a><form class="header-search" action="/san-pham/" role="search"><Icon name="search" size={20} /><input name="q" type="search" placeholder="Tìm giải pháp, công suất…" aria-label="Tìm sản phẩm" /><button type="submit">Tìm</button></form><a class="header-phone" href={`tel:${site.phone}`} data-track="click_phone"><span class="phone-icon"><Icon name="phone" /></span><span><small>HOTLINE TƯ VẤN</small><strong>{site.phoneDisplay}</strong></span></a><button id="menu-toggle" class="menu-toggle" aria-label="Mở menu" aria-expanded="false" aria-controls="main-nav"><Icon name="menu" /></button></div><nav id="main-nav" class="main-nav" aria-label="Điều hướng chính"><div class="container nav-inner">{nav.map(([href, label]) => <a href={href} class:list={{ active: href === '/' ? current === '/' : current.startsWith(href.split('/').slice(0, 2).join('/') + '/') }} aria-current={current === href ? 'page' : undefined}>{label}</a>)}<a class="nav-consult" href="/lien-he/#tu-van">Đăng ký tư vấn</a></div></nav></header>
<main id="main"><slot /></main>
<footer class="site-footer"><div class="container footer-grid"><div class="footer-brand"><a href="/" class="brand"><span class="brand-symbol"><Icon name="sun" size={32} /></span><span>HƯỚNG DƯƠNG<small>SOLAR · NĂNG LƯỢNG XANH</small></span></a><p>{site.company}</p><p>Giải pháp điện mặt trời theo nhu cầu sử dụng thực tế của gia đình và doanh nghiệp.</p><a href={`tel:${site.phone}`} class="footer-hotline" data-track="click_phone">{site.phoneDisplay}</a></div><div><h3>Khám phá</h3><a href="/gioi-thieu/">Về Hướng Dương Solar</a><a href="/san-pham/">Danh mục sản phẩm</a><a href="/giai-phap/hoa-luoi/">Điện mặt trời hòa lưới</a><a href="/giai-phap/luu-tru/">Hybrid lưu trữ</a><a href="/du-an/">Hình ảnh & triển khai</a></div><div><h3>Hỗ trợ khách hàng</h3><a href="/chi-phi-lap-dat/">Chi phí & báo giá</a><a href="/kien-thuc/">Kiến thức điện mặt trời</a><a href="/chinh-sach-bao-mat/">Chính sách bảo mật</a><a href="/lien-he/">Liên hệ tư vấn</a><a href={site.zalo} target="_blank" rel="noopener noreferrer" data-track="click_zalo">Trao đổi qua Zalo</a></div><div class="footer-contact"><h3>Thông tin liên hệ</h3><p><Icon name="pin" size={18} />{site.address}</p><p><Icon name="mail" size={18} /><a href={`mailto:${site.email}`}>{site.email}</a></p><p><Icon name="clock" size={18} />Lịch khảo sát được thống nhất khi tư vấn.</p></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} {site.company}</span><a href="/chinh-sach-bao-mat/">Thông tin & quyền riêng tư</a></div></footer>
<div class="floating-contact"><a href={site.zalo} target="_blank" rel="noopener noreferrer" data-track="click_zalo" aria-label="Nhắn Zalo tư vấn"><Icon name="chat" /><span>Zalo</span></a><a href={`tel:${site.phone}`} data-track="click_phone" aria-label="Gọi tư vấn"><Icon name="phone" /><span>Gọi ngay</span></a></div>
<script>
import { campaignForPage } from '../scripts/campaign';
try { const previous=JSON.parse(sessionStorage.getItem('solar_campaign')||'{}'); sessionStorage.setItem('solar_campaign',JSON.stringify(campaignForPage(location.search,previous))); } catch { /* The form also reads campaign values from the current URL. */ }
const toggle=document.querySelector<HTMLButtonElement>('#menu-toggle');const menu=document.querySelector('#main-nav');toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'Đóng menu':'Mở menu');menu?.classList.toggle('is-open',open);});document.querySelectorAll<HTMLAnchorElement>('[data-track]').forEach(link=>link.addEventListener('click',()=>{const w=window as Window & {dataLayer?:Record<string,unknown>[]};(w.dataLayer||=[]).push({event:link.dataset.track,page_path:location.pathname});}));</script>
</body></html>
