---
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<form id="lead-form" class="lead-form" method="post" action="/api/lead">
  <label><span>Số điện thoại <span aria-hidden="true">*</span></span><input type="tel" name="phone" autocomplete="tel" inputmode="tel" required maxlength="30" placeholder="Số để nhân viên liên hệ" /></label>
  <label><span>Khu vực lắp đặt <span aria-hidden="true">*</span></span><input type="text" name="area" autocomplete="address-level2" required minlength="2" maxlength="160" placeholder="Quận/huyện, tỉnh/thành" /></label>
  <div class="form-grid">
    <label>Họ tên<input type="text" name="name" autocomplete="name" maxlength="100" placeholder="Không bắt buộc" /></label>
    <label>Tiền điện mỗi tháng<select name="monthly_bill"><option value="">Chọn nếu thuận tiện</option><option>Dưới 1 triệu đồng</option><option>1–3 triệu đồng</option><option>3–5 triệu đồng</option><option>Trên 5 triệu đồng</option></select></label>
  </div>
  <div class="honeypot" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
  <label class="consent"><input type="checkbox" name="consent" required /><span>Tôi đồng ý để đơn vị liên hệ về yêu cầu tư vấn này theo <a href="/chinh-sach-bao-mat/">chính sách bảo mật</a>.</span></label>
  {sitekey && <div class="cf-turnstile" data-sitekey={sitekey} data-theme="light" data-size="flexible"></div>}
  <button class="button w-full" type="submit">Đăng ký tư vấn</button>
  <p id="form-status" role="status" aria-live="polite"></p>
  <noscript><p>Vui lòng bật JavaScript để sử dụng biểu mẫu tư vấn hoặc liên hệ trực tiếp với đơn vị.</p></noscript>
</form>
{sitekey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" is:inline async defer></script>}
<script>
  import { campaignForPage } from '../scripts/campaign';
  const form = document.querySelector<HTMLFormElement>('#lead-form');
  const status = document.querySelector<HTMLParagraphElement>('#form-status');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const w = window as Window & { turnstile?: { reset: () => void }; dataLayer?: Record<string, unknown>[] };
  let submissionId = crypto.randomUUID();
  form?.addEventListener('submit', async event => {
    event.preventDefault();
    if (!status || !submit) return;
    const data = new FormData(form);
    const token = data.get('cf-turnstile-response');
    if (!token) { status.textContent = 'Vui lòng chờ xác minh hoàn tất rồi gửi lại.'; return; }
    submit.disabled = true; submit.textContent = 'Đang gửi…'; status.textContent = '';
    let previous: Record<string,string> = {};
    try { previous = JSON.parse(sessionStorage.getItem('solar_campaign') || '{}'); } catch { /* Storage can be unavailable. */ }
    const utm = campaignForPage(location.search, previous);
    try {
      const response = await fetch('/api/lead', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: submissionId, name: data.get('name'), phone: data.get('phone'),
          area: data.get('area'), monthly_bill: data.get('monthly_bill'), consent: data.get('consent') === 'on',
          website: data.get('website'), token, source_path: location.pathname, ...utm }),
        signal: AbortSignal.timeout(15000)
      });
      const result = await response.json();
      if (!response.ok || !result.success) throw new Error(result.message || 'Chưa gửi được yêu cầu. Vui lòng thử lại.');
      status.textContent = result.message;
      if (result.created) (w.dataLayer ||= []).push({ event: 'generate_lead', lead_id: result.id,
        form_name: 'solar_consultation', page_path: location.pathname });
      form.reset(); submissionId = crypto.randomUUID();
    } catch (error) {
      status.textContent = error instanceof Error && error.name !== 'TimeoutError'
        ? error.message : 'Kết nối bị gián đoạn. Vui lòng thử lại hoặc liên hệ trực tiếp.';
    } finally { submit.disabled = false; submit.textContent = 'Đăng ký tư vấn'; w.turnstile?.reset(); }
  });
</script>
