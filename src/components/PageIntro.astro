---
interface Props { eyebrow?: string; title: string; description?: string; }
const { eyebrow, title, description } = Astro.props;
---
<section class="page-intro"><div class="container"><nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span>/</span><span>{title}</span></nav>{eyebrow && <p class="eyebrow">{eyebrow}</p>}<h1>{title}</h1>{description && <p class="intro-description">{description}</p>}</div></section>
